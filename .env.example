# ─── App ─────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-super-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# ─── Database ─────────────────────────────────────────────────────────────
# MySQL
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/headphone_shop?charset=utf8mb4

# SQLite (Alternative for local dev)
# DATABASE_URL=sqlite:///headphone_shop.db

# PostgreSQL (optional alternative; not used by Docker Compose)
# DATABASE_URL=postgresql://username:password@localhost:5432/headphone_shop

# ─── File Uploads ─────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
